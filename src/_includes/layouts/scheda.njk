---
layout: layouts/base.njk
---
{% from "partials/struttura-editoriale.njk" import testataEditoriale, corpoEditoriale %}

{# Metadati Scheda dentro la stessa struttura normativa delle Analisi. #}
{% call testataEditoriale(categoria | archivioUrl, categoria, immagine) %}
  <div class="artkicker">Scheda di riferimento · {{ categoria }}</div>
  <h1>{{ titolo }}</h1>
  {% if ruolo %}<p class="standfirst">{{ ruolo }}</p>{% endif %}
  <div class="byline mono">
    <span>Scheda di riferimento</span>
    {% if aggiornata %}<span>Aggiornata {{ aggiornata | dataIt }}</span>{% endif %}
    {% if categoria %}<span>{{ categoria }}</span>{% endif %}
  </div>
{% endcall %}

{# Un eventuale infobox esplicito ha precedenza; le `specifiche` esistenti
   vengono adattate al medesimo componente senza cambiare il contratto dati. #}
{% set schedaInfobox = infobox | modelloInfobox("sistemi", {}, specifiche, page.inputPath) %}

{% call corpoEditoriale(schedaInfobox, "Specifiche della scheda") %}
  <div class="articlebody" data-section-navigation>
    {{ content | safe }}
  </div>

  {% set riferimenti = collections.riferimentiSistemi | riferimentiSistemiPerSlug(slug) %}
  {% if riferimenti.length %}
  <aside class="relbox" aria-label="Contenuti di Frontiera che citano il sistema" data-section-navigation-ignore>
    <div class="lab">Il sistema in Frontiera</div>
    {% for riferimento in riferimenti %}
      <a href="{{ riferimento.url }}"><span>{{ riferimento.codice }} · {{ riferimento.titolo }}</span><span class="arrow">→</span></a>
    {% endfor %}
  </aside>
  {% endif %}
{% endcall %}
