---
layout: layouts/base.njk
---
{% from "partials/struttura-editoriale.njk" import testataEditoriale, corpoEditoriale %}

{# Metadati Analisi dentro la struttura editoriale condivisa. #}
{% call testataEditoriale(sezione | archivioUrl, sezione, immagine) %}
  <div class="artkicker">{{ sezione }}{% if teatro %} · Teatro: {{ teatro }}{% endif %}</div>
  <h1>{{ titolo }}</h1>
  {% if sommario %}<p class="standfirst">{{ sommario }}</p>{% endif %}
  <div class="byline mono">
    <span>Analisi</span>
    <span>{{ data | dataIt }}</span>
    {% if domini and domini.length %}<span>Domini: {{ domini | join(", ") }}</span>{% endif %}
  </div>
{% endcall %}

{% set modelloInfobox = infobox | modelloInfobox("analisi", {}, null, page.inputPath) %}
{% call corpoEditoriale(modelloInfobox, "Sintesi dell’articolo") %}
  <div class="articlebody" data-section-navigation>
    {{ content | safe }}
  </div>

  {% set collegate = [] %}
  {% if sezione == "Attualità" %}
    {% set collegate = collections.sistemi | schedeBySlug(sistemi_citati) %}
  {% endif %}
  {% if collegate.length %}
  <aside class="relbox" aria-label="Sistemi citati" data-section-navigation-ignore>
    <div class="lab">Sistemi citati</div>
    {% for s in collegate %}
      <a href="{{ s.url }}"><span>{{ s.data.titolo }}{% if s.data.ruolo %} — {{ s.data.ruolo }}{% endif %}</span><span class="arrow">→</span></a>
    {% endfor %}
  </aside>
  {% endif %}
{% endcall %}
