---
layout: layouts/base.njk
---
{% from "partials/struttura-editoriale.njk" import corpoEditoriale %}
{% set modelloInfobox = infobox | modelloInfobox("pagina", {}, null, page.inputPath) %}
<div class="testata testata--articolo testata--pagina">
  <div class="inner">
    {% if kicker %}<div class="artkicker">{{ kicker }}</div>{% endif %}
    <h1>{{ titolo | default(titoloPagina) }}</h1>
  </div>
</div>

{% if modelloInfobox %}
  {% call corpoEditoriale(modelloInfobox, "Contatti", "page") %}
    <div class="page-body" data-section-navigation>
      {{ content | safe }}
    </div>
  {% endcall %}
{% else %}
  <article class="page foglio">
    <div class="page-body" data-section-navigation>
      {{ content | safe }}
    </div>
  </article>
{% endif %}
