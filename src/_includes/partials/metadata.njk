{# Contratto unico del <head>: ogni valore deriva da `seo`, calcolato globalmente. #}
<title>{{ seo.htmlTitle | escape }}</title>
<meta name="description" content="{{ seo.description | escape }}">
{% if seo.robots %}<meta name="robots" content="{{ seo.robots | escape }}">{% endif %}
{% if seo.canonical %}<link rel="canonical" href="{{ seo.canonical | escape }}">{% endif %}

<meta property="og:title" content="{{ seo.title | escape }}">
<meta property="og:description" content="{{ seo.description | escape }}">
<meta property="og:type" content="{{ seo.ogType | escape }}">
<meta property="og:url" content="{{ seo.ogUrl | escape }}">
<meta property="og:site_name" content="{{ site.titolo | escape }}">
<meta property="og:locale" content="{{ site.locale | escape }}">
<meta property="og:image" content="{{ seo.image.url | escape }}">
<meta property="og:image:alt" content="{{ seo.image.alt | escape }}">
{% if seo.image.width and seo.image.height %}<meta property="og:image:width" content="{{ seo.image.width }}">
<meta property="og:image:height" content="{{ seo.image.height }}">{% endif %}
{% if seo.isArticle and seo.publishedTime %}<meta property="article:published_time" content="{{ seo.publishedTime | escape }}">{% endif %}
{% if seo.isArticle and seo.modifiedTime %}<meta property="article:modified_time" content="{{ seo.modifiedTime | escape }}">{% endif %}
{% if seo.isArticle and seo.articleSection %}<meta property="article:section" content="{{ seo.articleSection | escape }}">{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo.title | escape }}">
<meta name="twitter:description" content="{{ seo.description | escape }}">
<meta name="twitter:image" content="{{ seo.image.url | escape }}">
<meta name="twitter:image:alt" content="{{ seo.image.alt | escape }}">

{% if seo.jsonLd %}<script type="application/ld+json">{{ seo.jsonLd | safe }}</script>{% endif %}
